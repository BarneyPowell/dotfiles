[user]
	name = Barney Powell
	email = 9741234+BarneyPowell@users.noreply.github.com
[core]
	editor = vim
	autocrlf = input
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[gpg]
	program = gpg
[commit]
	gpgsign = false
[init]
	defaultBranch = main
[push]
	default = simple
[alias]
	c = commit
	ca = commit -a
	cm = commit -m
	cam = commit -am
	d = diff
	dc = diff --cached
	l = log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit
[pull]
	rebase = true
